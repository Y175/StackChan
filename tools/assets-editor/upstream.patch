diff --git a/web/src/style.css b/web/src/style.css
index 5a397e6..ec79635 100644
--- a/web/src/style.css
+++ b/web/src/style.css
@@ -34,3 +34,36 @@ body {
 .tab-button.inactive {
   @apply text-gray-500 border-transparent hover:text-gray-700 hover:border-gray-300;
 }
+
+/* StackChan 的固定硬件无需重复配置，资源入口保持可直接访问。 */
+.workspace-header { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 32px; border-bottom: 1px solid #e2e8f0; background: #fff; }
+.workspace-brand { display: flex; align-items: center; gap: 10px; color: #0f172a; font-size: 17px; }
+.brand-face { display: grid; place-items: center; width: 32px; height: 30px; border-radius: 9px; background: #0f172a; color: #fff; letter-spacing: 5px; padding-left: 5px; font-size: 19px; }
+.workspace-main { max-width: 1440px; margin: auto; padding: 28px 32px; }
+.resource-workspace { display: grid; grid-template-columns: 208px minmax(0, 1fr); gap: 32px; align-items: start; }
+.workspace-sidebar { position: sticky; top: 24px; }
+.sidebar-eyebrow { margin: 4px 12px 14px; color: #64748b; font-size: 12px; }
+.resource-navigation { display: flex; flex-direction: column; gap: 5px; }
+.resource-nav-item { width: 100%; display: flex; flex-direction: column; gap: 5px; text-align: left; padding: 13px 14px; border-radius: 10px; color: #475569; }
+.resource-nav-item span { font-size: 14px; font-weight: 600; }
+.resource-nav-item small { font-size: 11px; color: #64748b; }
+.resource-nav-item:hover { background: #e8eef5; }
+.resource-nav-item.selected { background: #dce8fb; color: #1947a2; }
+.sidebar-device { margin: 28px 12px 0; padding-top: 20px; border-top: 1px solid #dbe3ed; display: flex; flex-direction: column; gap: 6px; color: #334155; font-size: 12px; }
+.sidebar-device strong { font-size: 15px; }
+.workspace-toolbar { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 18px; margin-bottom: 22px; }
+.export-button { background: #2563eb; color: white; padding: 11px 20px; border-radius: 9px; font-weight: 600; font-size: 14px; }
+.export-button:hover { background: #1d4ed8; }
+.export-button:disabled { opacity: .5; }
+.resource-content { padding: 26px; background: white; border: 1px solid #e2e8f0; border-radius: 14px; min-height: 420px; }
+button:focus-visible, a:focus-visible { outline: 2px solid #2563eb; outline-offset: 3px; }
+@media (max-width: 800px) {
+  .workspace-header { padding: 15px 18px; flex-wrap: wrap; }
+  .workspace-main { padding: 20px 16px; }
+  .resource-workspace { grid-template-columns: 1fr; gap: 20px; }
+  .workspace-sidebar { position: static; }
+  .resource-navigation { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 4px; }
+  .resource-nav-item { padding: 11px 7px; text-align: center; align-items: center; }
+  .resource-nav-item small, .sidebar-device, .sidebar-eyebrow { display: none; }
+  .resource-content { padding: 18px; }
+}
